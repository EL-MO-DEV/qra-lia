# Copy to .env.local (never commit real keys).
# If both keys are empty, the API runs in mock mode so the frontend is not blocked.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional. Comma-separated. Empty = no CORS (same-origin).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Force mock even if keys are set (useful for tests / demos)
# APP_MOCK_AI=false

SERVER_PORT=18080
