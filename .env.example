# Copy to .env.local and add your own keys. Never commit real keys.

# Reading documents (primary): Google Gemini, vision + structured JSON.
# GEMINI_MODEL is optional (default gemini-3.8-flash); comma-separated backups allowed.
GEMINI_API_KEY=
GEMINI_MODEL=

# Reading documents (fallback): Groq vision model. GROQ_MODEL optional (default qwen/qwen3.8-27b).
GROQ_API_KEY=
GROQ_MODEL=

# Voice, all optional: Gemini TTS model (default gemini-3.8-flash-tts), voice (default Sulafat),
# and a separate key for the voice (defaults to GEMINI_API_KEY).
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
GEMINI_TTS_API_KEY=

# WhatsApp bot (official WhatsApp Cloud API) — values only in Vercel
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
